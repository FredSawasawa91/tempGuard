PORT=3000
DB_NAME=temp_guard_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
JWT_SECRET=replace-me-with-a-long-random-secret

# Email Configuration
EMAIL_HOST=smtp.mail.yahoo.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
ALERT_EMAILS=admin1@tempguard.com,admin2@tempguard.com

# App URL for email links
APP_URL=http://localhost:3000

# Test data auto-seed (first run only, background + terminal progress)
# true = always seed when empty, false = never seed, unset = seed unless NODE_ENV=production
SEED_TEST_DATA=true
# SEED_FORCE=true wipes + reseeds on next boot / npm run seed:force
# SEED_VERBOSE=true for per-chunk progress
